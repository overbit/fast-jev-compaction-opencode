{
  "name": "fast-jev-compaction-opencode",
  "version": "0.1.0",
  "description": "Verbatim Jev-guided compaction for OpenCode v2 with TypeSafe and local OpenAI-compatible backends.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./tui": {
      "types": "./src/tui.ts",
      "import": "./src/tui.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@opencode-ai/plugin": "1.18.32"
  }
}
