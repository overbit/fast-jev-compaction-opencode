{
  "name": "fast-jev-compaction-opencode",
  "version": "0.2.0",
  "description": "JEV-guided context compaction for OpenCode V2: prune stale tool history with hosted or local decision models instead of rewriting conversations with an LLM.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./tui": {
      "types": "./src/tui.ts",
      "import": "./src/tui.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compile": "tsc",
    "site:check": "node scripts/check-site.mjs",
    "site:serve": "python3 -m http.server 4173 --directory site"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.4"
  },
  "engines": {
    "opencode": ">=2.0.0 <3"
  }
}
