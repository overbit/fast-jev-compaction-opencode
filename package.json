{
  "name": "fast-jev-compaction-opencode",
  "version": "0.2.0",
  "description": "Verbatim JEV-guided compaction for OpenCode V2 with TypeSafe and local OpenAI-compatible backends.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./tui": {
      "types": "./src/tui.ts",
      "import": "./src/tui.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compile": "tsc"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.4",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "opencode": ">=2.0.0 <3"
  }
}
