{
  "name": "fast-jev-compaction-opencode",
  "version": "0.2.0",
  "description": "OpenCode V2 context compression and compaction plugin that prunes stale tool calls with JEV decision models instead of rewriting conversation history.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./tui": {
      "types": "./src/tui.ts",
      "import": "./src/tui.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compile": "tsc",
    "site:check": "node scripts/check-site.mjs",
    "site:serve": "python3 -m http.server 4173 --directory site"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.4"
  },
  "engines": {
    "opencode": ">=2.0.0 <3"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context-compaction",
    "context-compression",
    "context-pruning",
    "context-window",
    "compact",
    "summarize",
    "coding-agent",
    "llm",
    "jev",
    "typescript"
  ]
}
